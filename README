SOLD SCRIPT
select res.title, sum(res.count) from
(select to_jsonb(item) ->'jsonb_array_elements'->'data'->>'title' as "title",  CAST((to_jsonb(item)->'jsonb_array_elements'->>'count') AS INT) as "count"
from (SELECT jsonb_array_elements(data->'items') FROM orders where created >= '2022-12-01' and state = 'sent_to_customer') as item) as res group by 1 order by 2 desc


